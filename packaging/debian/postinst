#!/bin/sh
set -e
if [ "$1" = "configure" ]; then
    chown root:root /opt/accelpro-vpn/accelpro-helper /opt/accelpro-vpn/accelpro_client 2>/dev/null || true
    chmod 0755 /opt/accelpro-vpn/accelpro-helper /opt/accelpro-vpn/accelpro_client 2>/dev/null || true
    command -v gtk-update-icon-cache >/dev/null 2>&1 && gtk-update-icon-cache -q -t -f /usr/share/icons/hicolor || true
    command -v update-desktop-database >/dev/null 2>&1 && update-desktop-database -q /usr/share/applications || true
fi
exit 0
